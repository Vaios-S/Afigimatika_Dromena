---
/**
 * "Red thread" section: the opening verse, the milestones and the closing
 * line. The thread is drawn by src/scripts/red-thread.ts; the data-thread-*
 * attributes mark what it measures. Without JavaScript everything is visible.
 * Desktop: cards alternate left and right, overlapping vertically, leaving a
 * central gutter for the thread. Mobile: one column with a left gutter.
 * The thread's box and the bow are in the markup from the first paint, sized
 * by CSS; the script only fills in the paths, clips the box and places the
 * bow with a transform, so drawing the thread never shifts the layout.
 */
import Ornament from "../../components/Ornament.astro";
import Photo from "../../components/Photo.astro";
import { redThread, SHOW_PLACEHOLDER_TAGS, site } from "../../data/site";
import { FIBRE_WIDTH, TICK_WIDTH } from "../../lib/thread";
---

<section class="red-thread" aria-labelledby="red-thread-title" data-red-thread>
  <div class="thread" aria-hidden="true" data-thread>
    <svg class="thread-svg" focusable="false">
      <path class="thread-line thread-core"></path>
      <path class="thread-twist" stroke-width={TICK_WIDTH}></path>
      <path class="thread-line" stroke-width={FIBRE_WIDTH}></path>
      <path class="thread-fill"></path>
    </svg>
  </div>
  <svg
    class="thread-bow"
    viewBox="-50 -26 100 70"
    aria-hidden="true"
    focusable="false"
    data-thread-bow
  >
    <path
      class="thread-line"
      stroke-width="4"
      d="M0 0C-12-18-40-22-44-6-47 8-20 8 0 0ZM0 0C12-18 40-22 44-6 47 8 20 8 0 0Z"
    ></path>
    <path
      class="thread-twist"
      stroke-width="0.9"
      d="M-30-10-26-4M-20-12-16-5M30-10 26-4M20-12 16-5"
    ></path>
    <path
      class="thread-line"
      stroke-width="4"
      d="M-2 2C-8 16-18 28-30 40M2 2C8 16 16 30 30 38"
    ></path>
    <ellipse class="thread-fill" rx="6" ry="7"></ellipse>
  </svg>

  <div class="intro" data-thread-intro>
    <h2 id="red-thread-title" class="label title">
      {redThread.title}
    </h2>
    <p class="verse">
      {redThread.verse.map((line, i) => (
        <span class="verse-line" style={`--line: ${i}`}>
          {line}
        </span>
      ))}
    </p>
    <p class="verse-note">{redThread.verseNote}</p>
  </div>

  <ol class="milestones" role="list">
    {redThread.milestones.map((milestone) => (
      <li class="milestone" data-thread-card>
        <div class="divider" aria-hidden="true">
          <span />
          <Ornament name="flower" />
          <span />
        </div>
        <div class="meta">
          <span class="label">{milestone.year}</span>
          {SHOW_PLACEHOLDER_TAGS && milestone.placeholder && (
            <span class="placeholder-tag">{site.placeholderTag}</span>
          )}
        </div>
        <h3 class="milestone-title">{milestone.title}</h3>
        <p class="milestone-text">{milestone.text}</p>
        {milestone.image && (
          <div class="photo-frame">
            <Photo
              image={milestone.image}
              sizes="(width < 760px) calc(100vw - 88px), 450px"
            />
          </div>
        )}
      </li>
    ))}
  </ol>

  <div class="ending" data-thread-end>
    <p class="ending-text">
      {redThread.ending.text} <em>{redThread.ending.accent}</em>
    </p>
    <Ornament name="sprig" class="sprig" />
  </div>
</section>

<script>
  import "../../scripts/red-thread";
</script>

<style>
  .red-thread {
    position: relative;
    padding: var(--space-section) var(--space-gutter) var(--space-6xl);
  }

  /* Content sits above the thread. */
  .intro,
  .milestones,
  .ending {
    position: relative;
    z-index: 1;
  }

  /* Thread (drawn by the script) ---------------------------------------------- */
  /* A window over the whole section (plus room above it for the start under the yarn ball) that never moves; the script reveals the thread with a rectangular clip-path. See red-thread.ts. */
  .thread {
    position: absolute;
    top: calc(-1 * var(--thread-overhang));
    bottom: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    pointer-events: none;
    will-change: transform;
  }

  .thread-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .thread-line,
  .thread-twist {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .thread-line {
    stroke: var(--thread-color);
  }

  .thread-core {
    stroke-width: var(--thread-width);
  }

  .thread-twist {
    stroke: var(--thread-twist-color);
  }

  .thread-fill {
    fill: var(--thread-color);
  }

  /* The bow over the closing line: placed by the script with a transform. */
  .thread-bow {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--thread-bow-width);
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--thread-end-duration) ease;
  }

  .thread-bow.is-shown {
    opacity: 1;
  }

  /* Reveal states: only while the script runs with motion allowed. ------------ */
  .is-animated .verse-line {
    opacity: 0;
    transform: translateY(var(--thread-verse-offset));
    transition:
      opacity var(--thread-verse-duration) ease,
      transform var(--thread-verse-duration) var(--ease-out);
    transition-delay: calc(var(--line) * var(--thread-verse-delay));
  }

  .is-animated .milestone {
    opacity: 0;
    transform: translateY(var(--thread-card-offset));
    transition:
      opacity var(--thread-card-duration) ease,
      transform var(--thread-card-duration) var(--ease-out);
  }

  .is-animated .ending {
    opacity: 0;
    transition: opacity var(--thread-end-duration) ease;
  }

  .is-animated .intro:global(.is-shown) .verse-line,
  .is-animated .milestone:global(.is-shown),
  .is-animated .ending:global(.is-shown) {
    opacity: 1;
    transform: none;
  }

  /* Intro -------------------------------------------------------------------- */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: var(--width-text);
    margin-inline: auto;
    text-align: center;
  }

  .title {
    margin-bottom: var(--space-l);
    letter-spacing: var(--tracking-label-wide);
  }

  .verse {
    font-family: var(--font-display);
    font-size: var(--text-verse);
    font-style: italic;
    line-height: var(--leading-verse);
  }

  .verse-line {
    display: block;
  }

  .verse-line:first-child {
    color: var(--color-ink-red);
  }

  .verse-note {
    margin-top: var(--space-xl);
    font-style: italic;
    color: var(--color-ink-muted);
  }

  /* Milestones --------------------------------------------------------------- */
  .milestones {
    display: flex;
    flex-direction: column;
    max-width: var(--width-content);
    margin: var(--space-8xl) auto 0;
    padding: 0;
    list-style: none;
  }

  .milestone {
    /* 460px at the 1440 frame; narrower on tablets so the gutter stays open. */
    width: min(28.75rem, 44%);
    padding-bottom: var(--space-m);
    border-bottom: var(--rule-hair) solid var(--color-ink-red);
  }

  .milestone:nth-child(odd) {
    align-self: flex-start;
  }

  .milestone:nth-child(even) {
    align-self: flex-end;
  }

  /* Alternating cards overlap vertically, as in the design. */
  .milestone + .milestone {
    margin-top: calc(-1 * var(--space-6xl));
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-ink-red);
  }

  .divider::before,
  .divider::after {
    content: "";
    width: 6px;
    height: 6px;
    background: currentColor;
    transform: rotate(45deg);
  }

  .divider span {
    flex: 1;
    height: var(--rule-thin);
    background: currentColor;
  }

  .divider :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }

  .milestone-title {
    margin-top: var(--space-2xs);
    font-size: var(--text-title);
  }

  .milestone-text {
    margin-top: var(--space-2xs);
  }

  .photo-frame {
    margin-top: var(--space-s);
    padding: var(--frame-gap);
    border: var(--rule-hair) solid var(--color-ink-red);
  }

  /* Ending ------------------------------------------------------------------- */
  .ending {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    margin-top: calc(var(--space-8xl) + var(--space-3xl));
    text-align: center;
  }

  .ending-text {
    font-family: var(--font-display);
    font-size: var(--text-quote);
    font-style: italic;
    line-height: var(--leading-verse);
  }

  .ending-text em {
    color: var(--color-ink-red);
  }

  .ending :global(.sprig) {
    width: 16.25rem;
    color: var(--color-ink-red);
  }

  /* Mobile: one column; the left gutter is kept for the thread. ---------------- */
  @media (width < 760px) {
    .thread-bow {
      width: var(--thread-bow-width-mobile);
    }

    .red-thread {
      padding: var(--space-6xl) var(--space-m) var(--space-4xl) var(--space-4xl);
    }

    .intro,
    .ending {
      align-items: flex-start;
      text-align: left;
    }

    .title {
      margin-bottom: var(--space-s);
    }

    .verse-note {
      margin-top: var(--space-m);
    }

    .milestones {
      margin-top: var(--space-5xl);
    }

    .milestone {
      width: auto;
    }

    .milestone + .milestone {
      margin-top: var(--space-2xl);
    }

    .ending {
      margin-top: var(--space-8xl);
    }

    .ending :global(.sprig) {
      display: none;
    }
  }
</style>
