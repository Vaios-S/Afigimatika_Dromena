---
/**
 * "Η ομάδα": short introduction, the ages statement with the shorter places
 * frieze (shared with /proskaleste-mas), and the invite button.
 */
import AgesFrieze from "../../components/AgesFrieze.astro";
import Button from "../../components/Button.astro";
import { about, invite } from "../../data/site";
---

<section class="about" aria-labelledby="about-title">
  <div class="intro">
    <div>
      <p class="label kicker">{about.kicker}</p>
      <h2 id="about-title" class="title">
        {about.title.text} <em>{about.title.accent}</em>
      </h2>
    </div>
    <div>
      <p class="text">{about.text}</p>
      <a href={about.link.href} class="more">
        {about.link.label}
      </a>
    </div>
  </div>

  <AgesFrieze level={3} short class="frieze" />

  <div class="cta">
    <Button href={invite.href} class="cta-button">
      {invite.label}
    </Button>
  </div>
</section>

<style>
  .about {
    max-width: calc(var(--width-content) + 2 * var(--space-gutter));
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter)
      calc(var(--space-section) + var(--space-2xs));
  }

  /* Intro -------------------------------------------------------------------- */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: var(--space-4xl) calc(var(--space-6xl) + var(--space-s));
  }

  .kicker {
    letter-spacing: var(--tracking-label-wide);
  }

  .title {
    margin-top: var(--space-s);
    font-size: var(--text-h2);
    line-height: var(--leading-display);
  }

  .text {
    font-size: var(--text-body-l);
    line-height: 1.65;
  }

  .more {
    display: inline-block;
    margin-top: var(--space-s);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    text-decoration-thickness: var(--rule-hair);
    text-underline-offset: 6px;
  }

  .about :global(.frieze) {
    margin-top: calc(var(--space-7xl) + var(--space-2xs));
  }

  .cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-5xl);
  }

  /* Mobile ------------------------------------------------------------------ */
  @media (width < 760px) {
    .about {
      padding-block: var(--space-5xl) var(--space-6xl);
    }

    .intro {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }

    .title {
      margin-top: var(--space-xs);
    }

    .cta {
      margin-top: var(--space-2xl);
    }

    .cta :global(.cta-button) {
      flex: 1;
    }
  }
</style>
