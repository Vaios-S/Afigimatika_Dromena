---
/**
 * Page intro for /proskaleste-mas: title and text, and beside them the three
 * questions every storytelling starts from, with a link down to the letter.
 */
import Ornament from "../../components/Ornament.astro";
import { SHOW_PLACEHOLDER_TAGS, site } from "../../data/site";
import { invite } from "../../data/invite";

const { intro } = invite;
---

<section class="intro" aria-labelledby="intro-title">
  <div class="main">
    <div class="labels">
      <p class="label kicker">{intro.label}</p>
      {SHOW_PLACEHOLDER_TAGS && intro.placeholder && (
        <span class="placeholder-tag">{site.placeholderTag}</span>
      )}
    </div>
    <h1 id="intro-title" class="title">
      {intro.title.text} <em>{intro.title.accent}</em>
    </h1>
    <p class="text">{intro.text}</p>
  </div>

  <aside class="questions" aria-labelledby="questions-title">
    <h2 id="questions-title" class="label questions-title">
      {intro.questionsTitle}
    </h2>
    <ul role="list">
      {intro.questions.map((question) => (
        <li>
          <Ornament name="flower" class="marker" />
          <span>{question}</span>
        </li>
      ))}
    </ul>
    <a href="#letter" class="to-form">
      {intro.toForm}
    </a>
  </aside>
</section>

<div class="divider">
  <Ornament name="crest" class="rough crest" />
</div>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    align-items: end;
    gap: var(--space-6xl) calc(var(--space-6xl) + var(--space-s));
    max-width: var(--width-page);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter)
      calc(var(--space-section) - var(--space-2xs));
  }

  .labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
  }

  .kicker {
    font-size: var(--text-kicker);
    letter-spacing: var(--tracking-label-wide);
  }

  .title {
    margin-top: var(--space-m);
    font-size: var(--text-page-title);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .text {
    max-width: 38.75rem;
    margin-top: var(--space-xl);
    font-size: var(--text-lead);
  }

  /* The three questions, set off by a red rule. */
  .questions {
    padding: var(--space-2xs) 0 var(--space-2xs)
      calc(var(--space-xl) + var(--space-3xs));
    border-left: var(--rule-thin) solid var(--color-ink-red);
  }

  .questions-title {
    font-size: var(--text-caption);
    letter-spacing: 0.14em;
  }

  .questions ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .questions li {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-family: var(--font-display);
    font-size: var(--text-entry);
    font-style: italic;
    line-height: 1.2;
  }

  .questions :global(.marker) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-ink-red);
  }

  .to-form {
    display: inline-block;
    margin-top: var(--space-l);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    text-decoration-thickness: var(--rule-hair);
    text-underline-offset: 6px;
  }

  .divider {
    display: flex;
    justify-content: center;
    color: var(--color-ink-red);
  }

  .divider :global(.crest) {
    width: 17.5rem;
    height: auto;
  }

  @media (width < 1100px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--space-xl);
    }
  }

  @media (width < 760px) {
    .intro {
      padding-block: var(--space-3xl) var(--space-4xl);
    }

    .labels {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .title {
      line-height: 1.04;
    }

    .text {
      margin-top: var(--space-m);
    }

    .questions {
      padding: var(--space-3xs) 0 var(--space-3xs) var(--space-m);
    }

    .questions ul {
      gap: var(--space-xs);
      margin-top: var(--space-s);
    }

    .questions :global(.marker) {
      width: 1rem;
      height: 1rem;
    }

    .divider :global(.crest) {
      width: 12.5rem;
    }
  }
</style>
