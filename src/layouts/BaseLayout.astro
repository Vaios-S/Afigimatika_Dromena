---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { LAUNCHED, site } from "../data/site";
import { groupData, SHARE_SIZE, shareImage, type ShareImage } from "../lib/seo";

interface Props {
  /** Page title; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Show the footer invitation; turned off on the invite page. */
  footerCta?: boolean;
  /** Share image (from shareImage in src/lib/seo.ts); the site image by default. */
  image?: ShareImage;
  /** Posts: shared as an article, with its date (YYYY-MM-DD) and section. */
  article?: { published: string; section: string };
  /** This page's own structured data (Article, Event…), next to the group's. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  footerCta = true,
  article,
  structuredData = [],
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;

// Absolute URLs are built from `site` in astro.config.mjs (contact.siteUrl).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteImage = await shareImage(Astro.site);
const share = Astro.props.image ?? siteImage;

// Structured data for search engines (src/lib/seo.ts).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [groupData(Astro.site, siteImage.url), ...structuredData],
};
// "<" is escaped so the JSON can never close the script tag early.
const jsonLdScript = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!LAUNCHED && <meta name="robots" content="noindex, nofollow" />}
    {LAUNCHED && <link rel="sitemap" href="/sitemap-index.xml" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={article ? "article" : "website"} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        <meta property="article:section" content={article.section} />
      </>
    )}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(SHARE_SIZE.width)} />
    <meta property="og:image:height" content={String(SHARE_SIZE.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLdScript}
    ></script>
  </head>
  <body>
    <!-- Shared SVG filter: gives ornaments with class="rough" a hand-printed edge. -->
    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <filter id="rough" x="-3%" y="-3%" width="106%" height="106%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.8"
          numOctaves="2"
          seed="4"
        ></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="2.4"></feDisplacementMap>
      </filter>
    </svg>
    <a href="#main" class="skip-link">
      {site.skipLink}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer cta={footerCta} />
  </body>
</html>

<style>
  .svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .skip-link {
    position: absolute;
    top: var(--space-s);
    left: var(--space-s);
    z-index: 10;
    padding: var(--space-xs) var(--space-s);
    background: var(--color-ink-red);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
