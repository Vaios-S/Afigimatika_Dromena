---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { news } from "../../data/news";
import { getListingPage, getUpcomingEvents } from "../../lib/news";
import { eventData, shareImage } from "../../lib/seo";
import Chronicle from "../../sections/news/Chronicle.astro";
import EventsBoard from "../../sections/news/EventsBoard.astro";
import Intro from "../../sections/news/Intro.astro";

const events = await getUpcomingEvents();
const listing = await getListingPage(undefined, 1);
const image = await shareImage(Astro.site);
---

<BaseLayout
  title={news.meta.title}
  description={news.meta.description}
  structuredData={events.map((event) =>
    eventData(Astro.site, event, image.url),
  )}
>
  <Intro />
  <EventsBoard events={events} />
  <Chronicle listing={listing} />
</BaseLayout>
