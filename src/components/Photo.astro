---
/**
 * Renders an image from the registry (src/data/images.ts) by key.
 * Placeholder entries show placeholders/photo.svg with the alt text as a
 * visible caption; real entries are optimized with Astro's <Picture>.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import placeholderPhoto from "../assets/placeholders/photo.svg";
import { images, type ImageKey } from "../data/images";
import { site } from "../data/site";

interface Props {
  image: ImageKey;
  /** Rendered width hint for responsive images, as in the `sizes` attribute. */
  sizes: string;
  class?: string;
}

const files = import.meta.glob<ImageMetadata>(
  "../assets/images/*.{jpg,jpeg,png,webp,avif}",
  { eager: true, import: "default" },
);

const { image, sizes, class: className } = Astro.props;
const entry = images[image];
const file = files[`../assets/images/${entry.src}`];

if (!entry.placeholder && !file) {
  throw new Error(
    `Image "${image}": src/assets/images/${entry.src} not found. Add the file or set placeholder: true.`,
  );
}
---

{entry.placeholder || !file ? (
  <div class:list={["photo", "placeholder", className]}>
    <img src={placeholderPhoto.src} alt="" width="480" height="270" />
    <span class="caption">
      {site.photoPlaceholder} · {entry.alt}
    </span>
  </div>
) : (
  <Picture
    src={file}
    alt={entry.alt}
    sizes={sizes}
    widths={[480, 720, 960]}
    formats={["avif", "webp"]}
    class:list={["photo", className]}
  />
)}

<style>
  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .placeholder {
    position: relative;
  }

  .placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .caption {
    position: absolute;
    bottom: var(--space-xs);
    left: 50%;
    max-width: calc(100% - 2 * var(--space-xs));
    padding: var(--space-3xs) var(--space-2xs);
    transform: translateX(-50%);
    background: var(--color-paper);
    color: var(--color-ink-red);
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    line-height: 1.35;
    text-align: center;
  }
</style>
