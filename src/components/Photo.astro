---
/**
 * Renders an image from the registry (src/data/images.ts) by key.
 * Placeholder entries show placeholders/photo.svg with the alt text as a
 * visible caption; real entries are optimized with Astro's <Picture>.
 */
import { Picture } from "astro:assets";
import placeholderPhoto from "../assets/placeholders/photo.svg";
import { imageFile, images, type ImageKey } from "../data/images";
import { site } from "../data/site";

interface Props {
  image: ImageKey;
  /** Rendered width hint for responsive images, as in the `sizes` attribute. */
  sizes: string;
  /** Shape of the frame, as a CSS aspect-ratio (the image is cropped to fill it). */
  ratio?: string;
  class?: string;
}

const { image, sizes, ratio = "16 / 9", class: className } = Astro.props;
const style = `--ratio: ${ratio}`;
const entry = images[image];
const file = imageFile(image);
---

{!file ? (
  <div class:list={["photo", "placeholder", className]} style={style}>
    <img src={placeholderPhoto.src} alt="" width="480" height="270" />
    <span class="caption">
      {site.photoPlaceholder} · {entry.alt}
    </span>
  </div>
) : (
  <Picture
    src={file}
    alt={entry.alt}
    sizes={sizes}
    widths={[480, 720, 960]}
    formats={["avif", "webp"]}
    class:list={["photo", className]}
    style={style}
  />
)}

<style>
  .photo {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }

  .placeholder {
    position: relative;
  }

  .placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .caption {
    position: absolute;
    bottom: var(--space-xs);
    left: 50%;
    max-width: calc(100% - 2 * var(--space-xs));
    padding: var(--space-3xs) var(--space-2xs);
    transform: translateX(-50%);
    background: var(--color-paper);
    color: var(--color-ink-red);
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    line-height: 1.35;
    text-align: center;
  }
</style>
