---
/**
 * Renders a photo: either a site image from the registry (src/data/images.ts,
 * by key) or a content image (a NewsImage from src/lib/news.ts).
 * Placeholders show placeholders/photo.svg with the alt text as a visible
 * caption; real images are optimized with Astro's <Picture> (a local file,
 * or a remote URL with its width and height, as Sanity will provide).
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import placeholderPhoto from "../assets/placeholders/photo.svg";
import { imageFile, images, type ImageKey } from "../data/images";
import { site } from "../data/site";
import type { NewsImage } from "../lib/news";

interface Props {
  image: ImageKey | NewsImage;
  /** Rendered width hint for responsive images, as in the `sizes` attribute. */
  sizes: string;
  /** Shape of the frame, as a CSS aspect-ratio (the image is cropped to fill it). */
  ratio?: string;
  /** Small frames: the placeholder caption shows only "Φωτογραφία", not the alt text. */
  compact?: boolean;
  class?: string;
}

const {
  image,
  sizes,
  ratio = "16 / 9",
  compact = false,
  class: className,
} = Astro.props;
const style = `--ratio: ${ratio}`;
// Generated widths. Post covers are shown up to 1100px wide, so 2200 serves
// retina screens; the browser picks by `sizes`, and Astro never enlarges a
// smaller original.
const widths = [480, 720, 960, 1440, 1920, 2200];

let alt: string;
let src: ImageMetadata | string | null;
let size: { width?: number; height?: number } = {};
if (typeof image === "string") {
  alt = images[image].alt;
  src = imageFile(image) ?? null;
} else {
  alt = image.alt;
  src = image.src;
  size = { width: image.width, height: image.height };
}
---

{!src ? (
  <div class:list={["photo", "placeholder", className]} style={style}>
    <img src={placeholderPhoto.src} alt="" width="480" height="270" />
    <span class="caption">
      {compact ? site.photoPlaceholder : `${site.photoPlaceholder} · ${alt}`}
    </span>
  </div>
) : typeof src === "string" ? (
  <Picture
    src={src}
    alt={alt}
    width={size.width ?? 1440}
    height={size.height ?? 960}
    sizes={sizes}
    widths={widths}
    formats={["avif", "webp"]}
    class:list={["photo", className]}
    style={style}
  />
) : (
  <Picture
    src={src}
    alt={alt}
    sizes={sizes}
    widths={widths}
    formats={["avif", "webp"]}
    class:list={["photo", className]}
    style={style}
  />
)}

<style>
  .photo {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }

  .placeholder {
    position: relative;
  }

  .placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .caption {
    position: absolute;
    bottom: var(--space-xs);
    left: 50%;
    max-width: calc(100% - 2 * var(--space-xs));
    padding: var(--space-3xs) var(--space-2xs);
    transform: translateX(-50%);
    background: var(--color-paper);
    color: var(--color-ink-red);
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    line-height: 1.35;
    text-align: center;
  }
</style>
