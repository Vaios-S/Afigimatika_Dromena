---
/**
 * The design's double-ruled button. Renders a link when `href` is given,
 * otherwise a <button>. Extra attributes are passed through.
 * primary: filled red with an inner paper rule. secondary: outlined.
 */
import type { HTMLAttributes } from "astro/types";

type Props = {
  variant?: "primary" | "secondary";
  size?: "sm" | "md";
} & (HTMLAttributes<"a"> | HTMLAttributes<"button">);

const {
  variant = "primary",
  size = "md",
  class: className,
  ...attrs
} = Astro.props;
const classes = ["button", variant, size, className];
---

{"href" in attrs && attrs.href ? (
  <a class:list={classes} {...(attrs as HTMLAttributes<"a">)}>
    <slot />
  </a>
) : (
  <button
    type="button"
    class:list={classes}
    {...(attrs as HTMLAttributes<"button">)}
  >
    <slot />
  </button>
)}

<style>
  .button {
    --ring: var(--button-ring);
    --fill: var(--color-ink-red);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--size-touch);
    padding: var(--button-padding);
    border: 0;
    font-family: var(--font-display);
    font-size: var(--text-button);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-button);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .sm {
    --ring: var(--button-ring-sm);
    padding: var(--button-padding-sm);
  }

  .primary,
  .primary:hover {
    color: var(--color-paper);
  }

  .primary {
    background-color: var(--fill);
    box-shadow:
      inset 0 0 0 var(--ring) var(--fill),
      inset 0 0 0 calc(var(--ring) + var(--rule-hair)) var(--color-paper);
  }

  .primary:hover {
    --fill: var(--color-oxblood);
  }

  .secondary,
  .secondary:hover {
    color: var(--color-ink-red);
  }

  .secondary {
    background-color: var(--color-paper);
    border: var(--rule-thin) solid var(--color-ink-red);
    box-shadow:
      inset 0 0 0 calc(var(--ring) - 0.5px) var(--color-paper),
      inset 0 0 0 calc(var(--ring) + 0.5px) var(--color-ink-red);
  }

  .secondary:hover {
    background-color: var(--color-paper-shade);
  }

  @media (width < 760px) {
    .md {
      padding: var(--button-padding-mobile);
    }

    .sm {
      padding: var(--button-padding-sm-mobile);
    }
  }
</style>
